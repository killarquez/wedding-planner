# ==============================================================================
# Supabase Configuration
# ==============================================================================
# Find these in your Supabase Project Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==============================================================================
# Admin & Couple Access
# ==============================================================================
# Comma-separated list of emails authorized to access the Admin CRM (/admin)
ADMIN_ALLOWED_EMAILS=alfredo@example.com,trang@example.com

# Optional: Next.js App URL for OAuth / Magic Link Redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
